{
  "name": "ski-sync_backend",
  "version": "1.0.0",
  "description": "A microservices-based API for ski-sync application",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"shared/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:api": "nest start api-gateway --watch",
    "start:user": "nest start user-service --watch",
    "start:statistics": "nest start statistics-service --watch",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint \"{src,apps,shared}/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@influxdata/influxdb-client": "^1.33.2",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^10.3.8",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^7.3.1",
    "@prisma/client": "^5.10.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.0",
