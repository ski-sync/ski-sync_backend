{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
    "plugins": [],
    "assets": []
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-service/tsconfig.app.json"
      }
    },
    "statistics-service": {
      "type": "application",
      "root": "apps/statistics-service",
      "entryFile": "main",
      "sourceRoot": "apps/statistics-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/statistics-service/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "shared",
      "entryFile": "index",
      "sourceRoot": "shared",
      "compilerOptions": {
        "tsConfigPath": "shared/tsconfig.lib.json"
      }
    }
  }
} 